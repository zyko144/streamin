TOKEN=token_du_bot_discord
CLIENT_ID=id_application_discord
GUILD_ID=id_du_serveur

# Role autorise a utiliser /setup et les commandes admin (en plus du proprietaire du serveur).
# Laisser vide pour n'autoriser que le proprietaire + les membres avec la permission "Administrateur".
ADMIN_ROLE_ID=

# Salon ou le bot poste les notifications de nouvelles commandes streamIN (cree ou reutilise par /setup)
ORDERS_CHANNEL_ID=

# Lecture seule du catalogue public (table `products`) pour la commande /stock.
# Meme projet Supabase que le site, cle publishable (safe cote client).
SHOP_SUPABASE_URL=
SHOP_SUPABASE_KEY=

# Optionnel : persistance des donnees du bot (tickets/boosts) dans Supabase
# au lieu du fichier local db.json (voir utils/db.js). Necessite une table
# `bot_data (id text primary key, data jsonb, updated_at timestamptz)`.
SUPABASE_URL=
SUPABASE_KEY=

# Pour /order_lookup (staff uniquement) : cle "service_role" Supabase, qui
# donne un acces TOTAL en lecture/ecriture a toute la base en ignorant les
# regles de securite (RLS). Necessaire car cette commande doit pouvoir
# retrouver la commande de N'IMPORTE QUEL client, pas seulement la tienne.
# Supabase Dashboard -> Project Settings -> API -> section "service_role".
# ATTENTION : ne colle JAMAIS cette cle dans un chat/message, uniquement ici
# ou directement dans les variables d'environnement Render.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du logo streamIN utilisee dans les embeds (defaut : le site Vercel)
LOGO_URL=https://shop-plus-nu.vercel.app/logo.png

# Optionnel : Render le fournit automatiquement en prod
PORT=3000

# Secret partage avec le site (shop-plus, meme valeur cote Vercel) pour le
# endpoint POST /internal/announcement-card : le site l'appelle pour
# generer ses cartes PNG d'annonce (rendu canvas qui ne fonctionne pas dans
# sa fonction serveur bundlee). Genere une valeur aleatoire longue, jamais
# la meme que TOKEN ou une autre cle.
INTERNAL_SECRET=
